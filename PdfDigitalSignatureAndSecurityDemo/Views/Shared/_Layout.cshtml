<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – PDF Sign &amp; Secure Demo</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
          integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN"
          crossorigin="anonymous" />
    <style>
        body      { background:#f5f7fa; }
        .navbar   { background:#0d6efd !important; }
        .navbar a, .navbar .navbar-brand { color:#fff !important; }
        main      { padding: 2rem 0; }
        .card     { box-shadow: 0 2px 6px rgba(0,0,0,.08); }
        pre.signature-info {
            background:#1e1e1e; color:#d4d4d4; padding:1rem; border-radius:6px;
            max-height: 480px; overflow:auto; font-size: 0.85rem;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/">PDF Sign &amp; Secure Demo</a>
            <div class="navbar-nav ms-auto">
                <a class="nav-link" href="/">Home</a>
                <a class="nav-link" href="/Signature/Sign">Sign &amp; Secure</a>
                <a class="nav-link" href="/Signature/Validate">Validate</a>
            </div>
        </div>
    </nav>

    <main>
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <footer class="text-center text-muted py-3 small">
        Built with ASP.NET Core &amp; Syncfusion .NET PDF Library
    </footer>

    @if (IsSectionDefined("Scripts"))
    {
        @RenderSection("Scripts", required: false)
    }
</body>
</html>
